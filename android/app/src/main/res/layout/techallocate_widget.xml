<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F4F6FB">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TechAllocate"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#202124" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Person Available: JO / CF -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/widget_card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Person Available"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#5F6368" />

            <TextView
                android:id="@+id/widget_jo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="JO - 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/widget_cf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="CF - 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124" />
        </LinearLayout>

        <!-- Task Running: PM / BM / CL / AD -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/widget_card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Running"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#5F6368" />

            <TextView
                android:id="@+id/widget_pm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="PM - 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/widget_bm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="BM - 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/widget_cl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="CL - 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/widget_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="AD - 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>